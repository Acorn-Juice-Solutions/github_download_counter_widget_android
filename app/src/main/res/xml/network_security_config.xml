<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The GitHub REST API is HTTPS-only. Reject any accidental HTTP request at the
         Android runtime layer instead of trusting library defaults. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
